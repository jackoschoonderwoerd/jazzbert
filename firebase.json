{
    "firestore": {
        "database": "(default)",
        "location": "europe-west1",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "site": "jazzbert-c0727-a260c",
        "public": "dist/jazzbert/browser",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [{
            "source": "**",
            "destination": "/index.html"
        }]
    },
    "auth": {
        "providers": {}
    },
    "functions": [{
        "source": "functions",
        "codebase": "default",
        "disallowLegacyRuntimeConfig": true,
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log",
            "*.local"
        ],
        "predeploy": [
            "npm --prefix functions run lint",
            "npm --prefix functions run build"
        ]
    }]
}
